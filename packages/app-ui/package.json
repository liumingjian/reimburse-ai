{
  "name": "@baox/app-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "本地报销应用前端模块：原型转高保真、契约固化、mock 适配器",
  "exports": {
    "./contract": {
      "types": "./src/contract/index.ts",
      "default": "./src/contract/index.ts"
    }
  },
  "scripts": {
    "dev": "vite",
    "dev:mock": "vite --mode mock",
    "build": "vite build",
    "build:mock": "vite build --mode mock",
    "check:dist": "vite build && node scripts/check-dist.mjs",
    "test": "vitest run",
    "test:e2e": "vite build --mode mock && playwright test",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "fixtures": "node fixtures/scripts/generate.mjs && node fixtures/scripts/verify.mjs",
    "fixtures:verify": "node fixtures/scripts/verify.mjs"
  },
  "dependencies": {
    "@carbon/feature-flags": "^1.9.0",
    "@carbon/icons-react": "^11.88.0",
    "@carbon/react": "^1.115.0",
    "@carbon/styles": "^1.115.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.3.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^27.0.0",
    "sass": "^1.104.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.0",
    "vite-plugin-singlefile": "^2.3.0",
    "vitest": "^3.2.0"
  }
}
