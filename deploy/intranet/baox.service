# The baox server on the phase-1 intranet host (docs/deployment/intranet-phase-1.md). install.sh installs this file
# as /etc/systemd/system/baox.service; edit it here, not there.

[Unit]
Description=baox reimbursement app
Documentation=file:///opt/tools/baox/current/docs/deployment/intranet-phase-1.md
After=network.target

[Service]
Type=simple
# Never root. The host's own Node lives in /root/.nvm, which this user cannot see, so the service runs the Node that
# install.sh puts under the deploy directory, at the version in the repo's .nvmrc.
User=baox
Group=baox
WorkingDirectory=/opt/tools/baox/current/server
ExecStart=/opt/tools/baox/runtime/node/bin/node /opt/tools/baox/current/server/dist/main.mjs

# The address employees reach the app at, and the most expensive constant of this deployment: every extension zip is
# stamped with it, and the app compares browsers' Origin and Host against it as literal strings. Written exactly as a
# browser writes Origin (no `:80`, no path; the server refuses to start otherwise). Changing it makes every employee
# reinstall the extension. It must equal the site address in the Caddyfile (install.sh checks).
Environment=BAOX_PUBLIC_ORIGIN=http://10.250.0.222
# Node binds 127.0.0.1:4319; only Caddy on :80 is reachable from the VPN.
Environment=BAOX_PORT=4319
Environment=BAOX_DATA_DIR=/opt/tools/baox/data
# The source-built better-sqlite3 binding needs the isolated GCC runtime. This affects only baox, not the host loader.
Environment=LD_LIBRARY_PATH=/opt/tools/baox/runtime/gcc-12.5.0/lib64
# The legacy `~/.baox` import (ADR-0015) runs once, when the first administrator is created. This path never exists,
# so this instance imports nothing and starts from an empty database.
Environment=BAOX_HOME=/opt/tools/baox/no-legacy-import
UMask=0077

# The host's 14 GiB are shared with MySQL, an Oracle client, Grafana and docker, 7.1 GiB already in use. Past
# MemoryHigh the kernel reclaims from baox first; at MemoryMax baox is OOM-killed and restarted, the databases are not
# touched. MemoryLimit= is the same cap for a cgroup-v1 host, where systemd may not apply MemoryMax=.
MemoryAccounting=yes
MemoryHigh=1536M
MemoryMax=2G
MemoryLimit=2G
# Should the whole host run out of memory, the kernel picks baox before the databases.
OOMScoreAdjust=500

Restart=on-failure
RestartSec=5
TimeoutStopSec=30

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectHome=yes

[Install]
WantedBy=multi-user.target
