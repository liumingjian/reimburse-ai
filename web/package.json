{
  "name": "@baox/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "本地报销应用前端：页面、HTTP 适配器与 mock 开发模式",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite",
    "dev:mock": "vite --mode mock",
    "build": "vite build",
    "build:mock": "vite build --mode mock",
    "check:dist": "vite build && node scripts/check-dist.mjs",
    "test": "vitest run",
    "test:e2e": "vite build --mode mock && playwright test",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "fixtures": "node fixtures/scripts/generate.mjs && node fixtures/scripts/verify.mjs",
    "fixtures:verify": "node fixtures/scripts/verify.mjs"
  },
  "dependencies": {
    "@baox/contract": "workspace:*",
    "@carbon/feature-flags": "1.9.0",
    "@carbon/icons-react": "11.88.0",
    "@carbon/react": "1.115.0",
    "@carbon/styles": "1.115.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.13.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "jsdom": "27.4.0",
    "sass": "1.104.1",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vite-plugin-singlefile": "2.3.3",
    "vitest": "3.2.7"
  }
}
